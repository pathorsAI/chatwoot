<% content_for :head do %>
  <title><%= I18n.t('public_portal.tickets.access.title') %> | <%= @portal.localized_value('name', @locale) %></title>
<% end %>

<div class="w-full max-w-[560px] mx-auto px-4 pt-10 pb-24">
  <h1 class="text-2xl font-bold text-center text-zinc-900 dark:text-zinc-100"><%= I18n.t('public_portal.tickets.access.title') %></h1>
  <p class="mt-2 text-xs text-center text-zinc-500 dark:text-zinc-400"><%= I18n.t('public_portal.tickets.access.description') %></p>

  <form action="/hc/<%= @portal.slug %>/tickets/access" method="POST" class="mt-6 space-y-6">
    <div class="space-y-2">
      <label class="block text-sm font-medium text-zinc-900 dark:text-zinc-100" for="access-email"><%= I18n.t('public_portal.tickets.fields.email') %></label>
      <input class="w-full h-10 px-3 text-sm bg-white border border-solid rounded-md dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-n-portal focus:border-transparent <%= @error.present? ? 'border-red-400' : 'border-zinc-200 dark:border-zinc-800' %>"
             id="access-email" type="email" name="email" placeholder="<%= I18n.t('public_portal.tickets.fields.email_placeholder') %>" autocomplete="email" required>
      <%= render 'public/api/v1/portals/tickets/field_error', message: @error %>
    </div>

    <button type="submit" class="w-full h-10 text-sm font-medium text-white transition-colors rounded-md cursor-pointer bg-n-portal hover:opacity-90">
      <%= I18n.t('public_portal.tickets.access.submit') %>
    </button>
  </form>

  <p class="mt-6 text-xs text-center text-zinc-500 dark:text-zinc-400">
    <a href="/hc/<%= @portal.slug %>/tickets/new" class="font-medium text-n-portal"><%= I18n.t('public_portal.tickets.access.submit_a_ticket') %></a>
  </p>
</div>
