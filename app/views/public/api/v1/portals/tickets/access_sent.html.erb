<% content_for :head do %>
  <title><%= I18n.t('public_portal.tickets.access_sent.title') %> | <%= @portal.localized_value('name', @locale) %></title>
<% end %>

<div class="w-full max-w-[560px] mx-auto px-4 pt-10 pb-24">
  <div class="text-center">
    <div class="flex items-center justify-center w-14 h-14 mx-auto rounded-full bg-green-100 text-green-600">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3.5 7 8.5 6 8.5-6" />
      </svg>
    </div>
    <h1 class="mt-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100"><%= I18n.t('public_portal.tickets.access_sent.title') %></h1>
    <p class="max-w-sm mx-auto mt-2 text-sm text-zinc-500 dark:text-zinc-400"><%= I18n.t('public_portal.tickets.access_sent.description') %></p>

    <div class="max-w-[280px] mx-auto mt-6">
      <a href="/hc/<%= @portal.slug %>/tickets/new" class="flex items-center justify-center w-full h-10 text-sm font-medium transition-colors rounded-md cursor-pointer bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 hover:opacity-90">
        <%= I18n.t('public_portal.tickets.access.submit_a_ticket') %>
      </a>
    </div>
  </div>
</div>
