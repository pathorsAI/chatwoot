<% content_for :head do %>
  <title><%= I18n.t('public_portal.tickets.index.title') %> | <%= @portal.localized_value('name', @locale) %></title>
<% end %>

<div class="w-full max-w-[560px] mx-auto px-4 pt-10 pb-24">
  <h1 class="text-xl font-bold text-zinc-900 dark:text-zinc-100"><%= I18n.t('public_portal.tickets.index.title') %></h1>
  <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
    <%= I18n.t('public_portal.tickets.index.subtitle', count: @tickets.size, email: @contact.email) %>
  </p>

  <% if @tickets.empty? %>
    <p class="mt-8 text-sm text-center text-zinc-500 dark:text-zinc-400"><%= I18n.t('public_portal.tickets.index.empty') %></p>
    <a href="<%= portal_ticket_link(@portal, '/new', @locale) %>" class="flex items-center justify-center w-full h-10 max-w-[240px] mx-auto mt-4 text-sm font-medium text-white transition-colors rounded-md cursor-pointer bg-n-portal hover:opacity-90">
      <%= I18n.t('public_portal.tickets.index.new_ticket') %>
    </a>
  <% else %>
    <ul class="mt-4 space-y-2.5">
      <% @tickets.each do |ticket| %>
        <li>
          <a href="<%= portal_ticket_link(@portal, "/#{ticket.id}", @locale) %>" class="flex items-center gap-3 px-5 py-3.5 border border-solid rounded-xl border-zinc-200 dark:border-zinc-800 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800">
            <svg class="flex-shrink-0 w-5 h-5 text-zinc-500 dark:text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M3 9h18" />
              <path d="M7 13h7" />
            </svg>
            <span class="flex-1 min-w-0">
              <span class="block text-sm font-medium truncate text-zinc-900 dark:text-zinc-100"><%= ticket.subject %></span>
              <span class="block text-xs text-zinc-500 dark:text-zinc-400">
                #<%= ticket.conversation.display_id %>
                <% if ticket.ticket_type.present? %>
                  · <%= I18n.t("public_portal.tickets.types.#{ticket.ticket_type}", default: ticket.ticket_type) %>
                <% end %>
                · <%= I18n.t('public_portal.tickets.index.updated_ago', time: time_ago_in_words(ticket.updated_at)) %>
              </span>
            </span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full whitespace-nowrap <%= ticket_status_category_classes(ticket.status_category) %>">
              <%= ticket_status_category_label(ticket) %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>

    <a href="<%= portal_ticket_link(@portal, '/new', @locale) %>" class="flex items-center justify-center w-full h-10 max-w-[240px] mx-auto mt-6 text-sm font-medium text-white transition-colors rounded-md cursor-pointer bg-n-portal hover:opacity-90">
      <%= I18n.t('public_portal.tickets.index.new_ticket') %>
    </a>
  <% end %>
</div>
