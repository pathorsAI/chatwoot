<%# locals: (portal:, category:) %>
<%
  category_link = generate_category_link(
    portal_slug: portal.slug,
    category_locale: category.locale,
    category_slug: category.slug,
    theme: @theme_from_params,
    is_plain_layout_enabled: false
  )
  articles = category.articles.published.order(position: :asc)
  listed_articles = articles.take(5)
%>
<div class="flex flex-col p-5 rounded-xl border border-solid border-zinc-200 dark:border-zinc-800">
  <h4 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
    <a href="<%= category_link %>" class="cursor-pointer transition-colors hover:text-n-portal"><%= category.name %></a>
  </h4>
  <% if category.description.present? %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"><%= category.description %></p>
  <% end %>

  <div class="flex flex-col mt-3">
    <% listed_articles.each_with_index do |article, index| %>
      <a href="<%= generate_article_link(portal.slug, article.slug, @theme_from_params, false) %>"
         class="flex items-start justify-between gap-4 py-1.5 text-sm cursor-pointer transition-colors text-zinc-900 dark:text-zinc-100 hover:text-n-portal <%= index.zero? ? '' : 'border-t border-solid border-zinc-100 dark:border-zinc-800' %>">
        <span><%= article.title %></span>
        <span class="text-zinc-500 dark:text-zinc-400" aria-hidden="true">&rsaquo;</span>
      </a>
    <% end %>
  </div>

  <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
    <%= render 'public/api/v1/portals/article_count', article_count: articles.size %>
  </p>
</div>
