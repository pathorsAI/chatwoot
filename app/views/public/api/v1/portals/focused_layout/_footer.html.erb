<%# locals: (global_config:) %>
<footer class="mt-auto border-t border-solid border-zinc-200 dark:border-zinc-800">
  <div class="flex items-center justify-center max-w-5xl gap-1.5 px-4 py-6 mx-auto md:px-8">
    <p class="text-xs text-zinc-500 dark:text-zinc-400">
      <%= I18n.t('public_portal.footer.made_with') %>
      <a class="font-medium cursor-pointer text-zinc-900 dark:text-zinc-100 hover:underline"
         href="<%= generate_portal_brand_url(global_config['BRAND_URL'], request.referer) %>"
         target="_blank" rel="noopener noreferrer nofollow"><%= global_config['INSTALLATION_NAME'] %></a>
    </p>
  </div>
</footer>
